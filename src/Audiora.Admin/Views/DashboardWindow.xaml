<Window x:Class="Audiora.Admin.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audiora Admin — Dashboard"
        Height="680" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E1E">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎵 AUDIORA"
                               Foreground="#1DB954"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" | Painel Admin"
                               Foreground="#B3B3B3"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserName}"
                               Foreground="#FFFFFF"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Button Content="Sair"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Título + botão recarregar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Músicas"
                               Foreground="#FFFFFF"
                               FontSize="22"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalMusics, StringFormat=' ({0} total)'}"
                               Foreground="#B3B3B3"
                               FontSize="14"
                               VerticalAlignment="Bottom"
                               Margin="8,0,0,2"/>
                </StackPanel>

                <Button Content="⟳  Recarregar"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        Width="130"
                        Command="{Binding LoadMusicsCommand}"/>
            </Grid>

            <!-- Loading -->
            <TextBlock Grid.Row="1"
                       Text="Carregando..."
                       Foreground="#1DB954"
                       FontSize="13"
                       Margin="0,0,0,12"
                       Visibility="{Binding IsLoading,
                           Converter={StaticResource BoolToVisibility}}"/>

            <!-- Tabela -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Musics}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="#1E1E1E"
                      Foreground="#FFFFFF"
                      BorderThickness="0"
                      RowBackground="#1E1E1E"
                      AlternatingRowBackground="#252525"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#333333"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      CanUserResizeRows="False">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2A2A2A"/>
                        <Setter Property="Foreground" Value="#1DB954"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Título"      Binding="{Binding Title}"      Width="2*"/>
                    <DataGridTextColumn Header="Artista"     Binding="{Binding ArtistName}"  Width="1.5*"/>
                    <DataGridTextColumn Header="Álbum"       Binding="{Binding AlbumTitle}"  Width="1.5*"/>
                    <DataGridTextColumn Header="Gênero"      Binding="{Binding Genre}"       Width="1*"/>
                    <DataGridTextColumn Header="Duração"     Binding="{Binding Duration}"    Width="0.7*"/>
                    <DataGridTextColumn Header="Streams"     Binding="{Binding StreamCount}" Width="0.8*"/>

                    <DataGridTemplateColumn Header="Ações" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Deletar"
                                        Style="{StaticResource DangerButton}"
                                        Margin="4"
                                        CommandParameter="{Binding}"
                                        Command="{Binding DataContext.DeleteMusicCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#1E1E1E">
            <TextBlock Text="{Binding StatusMsg}"
                       Foreground="#B3B3B3"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="24,0"/>
        </Border>
    </Grid>
</Window>